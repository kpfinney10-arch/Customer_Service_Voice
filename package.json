{
  "name": "voice-ai-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json && node scripts/write-build-metadata.mjs",
    "migrate:postgres": "node dist/src/persistence/migrate-main.js",
    "validate:postgres-recovery": "node dist/src/persistence/validate-recovery-main.js",
    "data:purge": "node dist/src/persistence/data-lifecycle-main.js tenant-purge",
    "data:retention": "node dist/src/persistence/data-lifecycle-main.js retention",
    "deploy:macos-local": "npm run build && node scripts/deploy-macos-runtime.mjs",
    "test": "node --test dist/tests/*.test.js",
    "start": "node dist/src/api/main.js",
    "start:cloudflare-named": "cloudflared tunnel run lanternbell-voice",
    "start:twilio-local": "node scripts/start-twilio-local.mjs",
    "start:twilio-tunnel": "node scripts/start-twilio-tunnel.mjs",
    "operator:provision": "npm run build --silent && node scripts/provision-operator-user.mjs",
    "smoke:extraction": "node scripts/first-call-extraction-smoke.mjs",
    "smoke:human-test": "node scripts/human-testing-smoke.mjs",
    "smoke:telnyx": "node scripts/telnyx-webhook-smoke.mjs",
    "smoke:twilio": "node scripts/twilio-webhook-smoke.mjs",
    "smoke:twilio-scenarios": "node scripts/twilio-scenario-matrix-smoke.mjs",
    "smoke:twilio-readiness": "node scripts/twilio-readiness-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "cloudflared": "^0.7.1",
    "pg-mem": "^3.0.14",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "pg": "^8.22.0",
    "ws": "^8.21.3"
  }
}
