NODE_ENV=development

# Comma-separated tenant API keys for local development.
# Format: tenantId:apiKey,otherTenant:otherApiKey
TENANT_API_KEYS=fh-demo:replace-with-local-dev-key

# Storage driver. Use memory for tests/local experiments and file for early human testing.
STORAGE_DRIVER=memory
STORAGE_DATA_DIR=.voice-ai-data

# Telephony provider credentials. Do not commit real values.
TELEPHONY_PROVIDER=
TELEPHONY_ACCOUNT_ID=
TELEPHONY_AUTH_TOKEN=
# Comma-separated provider webhook secrets. Format: provider:secret
# When empty, local telephony webhook signature verification is disabled.
TELEPHONY_WEBHOOK_SECRETS=
TELNYX_EXECUTE_COMMANDS=false
TELNYX_API_KEY=
TELNYX_API_BASE_URL=https://api.telnyx.com/v2

# Speech and model providers. Keep server-side only unless explicitly public.
STT_PROVIDER=
STT_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=
LLM_PROVIDER=
LLM_API_KEY=
FIRST_CALL_EXTRACTOR=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_TIMEOUT_MS=
FIRST_CALL_LLM_MIN_BASE_CONFIDENCE=

# Caller-facing language generation. Deterministic is the safe default.
# OpenAI mode prepares approved generic prompts at startup, never during a live caller turn.
# It never receives caller transcripts or collected facts.
CALLER_LANGUAGE_MODE=deterministic
CALLER_LANGUAGE_OPENAI_MODEL=gpt-5.6-luna
CALLER_LANGUAGE_OPENAI_TIMEOUT_MS=1200
CALLER_LANGUAGE_OPENAI_INPUT_USD_PER_MILLION=0.20
CALLER_LANGUAGE_OPENAI_CACHED_INPUT_USD_PER_MILLION=0.02
CALLER_LANGUAGE_OPENAI_CACHE_WRITE_USD_PER_MILLION=0.25
CALLER_LANGUAGE_OPENAI_OUTPUT_USD_PER_MILLION=1.20
CALLER_LANGUAGE_OPENAI_PRICING_VERSION=openai-public-2026-07-30

# Internal integrations.
CRM_API_BASE_URL=
CRM_API_TOKEN=
DISPATCH_API_BASE_URL=
DISPATCH_API_TOKEN=
